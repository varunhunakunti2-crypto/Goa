---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../components/supabase';

const { id } = Astro.params;
const fileName = `${id}.png`;

// Get the public URL for the image
let imageUrl = '';
if (supabase) {
  const { data } = supabase.storage.from('frames').getPublicUrl(fileName);
  imageUrl = data?.publicUrl || '';
} else {
  // Safe fallback if client is not configured
  imageUrl = `/fallback-frame.png`;
}
---

<Layout 
  title="HH Goa Hacker Card" 
  description="Check out my HH Goa hacker card! Generate yours instantly." 
  image={imageUrl}
>
  <div class="min-h-screen mesh-gradient-bg flex flex-col items-center justify-center p-4">

    <!-- Card Viewer Container -->
    <div class="w-full max-w-md bg-canvas border border-hairline rounded-lg p-6 custom-shadow-lg text-center flex flex-col items-center">
      <div class="mb-4">
        <h1 class="text-2xl font-bold tracking-tight text-ink font-sans">HackHind Goa 2026</h1>
        <p className="text-sm text-body font-mono uppercase mt-1">Verified Hacker Frame</p>
      </div>

      <!-- Preview Image -->
      <div class="w-full aspect-[2/3] max-w-sm rounded-md overflow-hidden border border-hairline bg-canvas-soft-2 custom-shadow-md mb-6 flex items-center justify-center">
        {imageUrl ? (
          <img 
            src={imageUrl} 
            alt="HH Goa Frame" 
            class="w-full h-full object-contain"
          />
        ) : (
          <p class="text-mute text-sm">Image loading or not found...</p>
        )}
      </div>

      <!-- Call to Action -->
      <div class="w-full space-y-3">
        <a 
          href="/" 
          class="w-full inline-flex items-center justify-center bg-primary text-on-primary py-3 px-6 rounded-pill font-medium hover:bg-opacity-90 active:scale-[0.98] transition-all custom-shadow-sm"
        >
          Create Your Own Frame
        </a>
        <p class="text-xs text-mute">
          Generate PFPs & Builder ID Cards instantly, no login required.
        </p>
      </div>
    </div>
  </div>
</Layout>
